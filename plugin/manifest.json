	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "linux"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"Name": "Matrix control panel",
			"UUID": "de.beasty.hdmi-matrix.panel",
			"Icon": "icons/panel",
