{
	"Name": "HDMI Matrix",
	"Description": "Route an HDCVT HDMI matrix from an OpenDeck profile",
	"Author": "Beasty",
	"Version": "0.1.0",
	"UUID": "de.beasty.hdmi-matrix",
	"CodePath": "bin/plugin.cjs",
	"Icon": "icons/plugin",
